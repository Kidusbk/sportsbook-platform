# =============================================================================
# Sportsbook Platform — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.
# =============================================================================

NODE_ENV=development
APP_NAME=sportsbook-platform
APP_PORT=3001
APP_HOST=0.0.0.0
APP_URL=http://localhost:3001
WEB_URL=http://localhost:5173
LOG_LEVEL=debug

DB_HOST=localhost
DB_PORT=5432
DB_NAME=sportsbook_dev
DB_USER=sportsbook
DB_PASSWORD=CHANGE_ME_dev_password_only
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_generate_a_random_64_byte_hex_string
JWT_REFRESH_SECRET=CHANGE_ME_generate_a_different_random_64_byte_hex_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_ROUNDS=12

SESSION_SECRET=CHANGE_ME_generate_another_random_string

CORS_ORIGINS=http://localhost:5173

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10

ENABLE_REGISTRATION=true
ENABLE_MFA=false
